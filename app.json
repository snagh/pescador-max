{
  "configVersion": "v3",
  "app": {
    "appId": 1127255,
    "appName": "PescaMax",
    "appType": "app",
    "version": {
      "code": 1,
      "name": "1.0.0"
    },
    "icon": "icon.png",
    "vender": "pescador",
    "description": "App de Pesca Inteligente para Amazfit Bip Max: Fases da Lua, Teoria Solunar, Piracema/Defeso e Pontos de Pesca"
  },
  "permissions": [
    "data:os.device.info",
    "device:os.local_storage",
    "device:os.geolocation",
    "device:os.barometer"
  ],
  "runtime": {
    "apiVersion": {
      "compatible": "3.0.0",
      "target": "3.0.0",
      "minVersion": "3.0"
    }
  },
  "targets": {
    "default": {
      "module": {
        "page": {
          "pages": [
            "page/home/index",
            "page/forecast/index",
            "page/defeso/index",
            "page/spots/index"
          ]
        }
      },
      "platforms": [
        {
          "st": "s",
          "dw": 432
        },
        {
          "st": "r",
          "dw": 480
        }
      ]
    }
  },
  "i18n": {
    "en-US": {
      "appName": "PescaMax"
    },
    "pt-BR": {
      "appName": "PescaMax"
    }
  },
  "defaultLanguage": "pt-BR",
  "debug": false
}
